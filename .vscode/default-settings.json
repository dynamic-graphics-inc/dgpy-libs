{
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [79, 80, 88, 100, 120],
  "editor.stickyScroll.enabled": true,
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "search.exclude": {
    "**/.ruff_cache": true,
    "**/.nox": true,
    "**/.nox_win": true,
    "**/.mypy_cache": true,
    "**/.venv": true,
    "**/.idea": true,
    "**/bower_components": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/temp": true,
    "**/test/**/temp": false
  }
}
